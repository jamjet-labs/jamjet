{
  "description": "Shared test vectors for the TypeScript (@jamjet/cloud) and Python (jamjet.cloud) Cloud SDKs. Both test suites read this file; the spec is in README.md next to it.",
  "glob": [
    {
      "pattern": "*delete*",
      "name": "database.delete_all",
      "match": true
    },
    {
      "pattern": "*delete*",
      "name": "Database.Delete_all",
      "match": false,
      "why": "case-sensitive on every platform"
    },
    {
      "pattern": "*Delete*",
      "name": "db.delete",
      "match": false,
      "why": "case-sensitive on every platform"
    },
    {
      "pattern": "db.[a-z]*",
      "name": "db.delete",
      "match": false,
      "why": "[ is a literal, not a character class"
    },
    {
      "pattern": "db.[a-z]*",
      "name": "db.[a-z]_x",
      "match": true
    },
    {
      "pattern": "[!a]",
      "name": "b",
      "match": false,
      "why": "no negated classes either"
    },
    {
      "pattern": "[!a]",
      "name": "[!a]",
      "match": true
    },
    {
      "pattern": "{a,b}",
      "name": "a",
      "match": false,
      "why": "no brace expansion"
    },
    {
      "pattern": "a?c",
      "name": "abc",
      "match": true
    },
    {
      "pattern": "a?c",
      "name": "ac",
      "match": false
    },
    {
      "pattern": "a?c",
      "name": "abbc",
      "match": false
    },
    {
      "pattern": "a?c",
      "name": "aéc",
      "match": true
    },
    {
      "pattern": "a?c",
      "name": "a😀c",
      "match": true,
      "why": "? is one Unicode code point, also outside the BMP"
    },
    {
      "pattern": "a*b",
      "name": "a\nb",
      "match": true,
      "why": "* also matches line breaks"
    },
    {
      "pattern": "a?b",
      "name": "a\nb",
      "match": true
    },
    {
      "pattern": "*",
      "name": "",
      "match": true
    },
    {
      "pattern": "**",
      "name": "anything.at.all",
      "match": true
    },
    {
      "pattern": "",
      "name": "",
      "match": true
    },
    {
      "pattern": "",
      "name": "x",
      "match": false
    },
    {
      "pattern": "payments.*",
      "name": "payments.refund",
      "match": true
    },
    {
      "pattern": "payments.*",
      "name": "payments",
      "match": false
    },
    {
      "pattern": "payments.*",
      "name": "paymentsXrefund",
      "match": false,
      "why": ". is a literal"
    },
    {
      "pattern": "a+b",
      "name": "aab",
      "match": false,
      "why": "regex syntax is literal"
    },
    {
      "pattern": "a+b",
      "name": "a+b",
      "match": true
    },
    {
      "pattern": "(x|y)",
      "name": "x",
      "match": false
    },
    {
      "pattern": "(x|y)",
      "name": "(x|y)",
      "match": true
    },
    {
      "pattern": "^x$",
      "name": "^x$",
      "match": true
    },
    {
      "pattern": "\\d",
      "name": "5",
      "match": false
    },
    {
      "pattern": "\\d",
      "name": "\\d",
      "match": true
    },
    {
      "pattern": "x",
      "name": "xy",
      "match": false,
      "why": "anchored to the whole name"
    },
    {
      "pattern": "mcp__*__delete",
      "name": "mcp__pg__delete",
      "match": true
    },
    {
      "pattern": "wire_*",
      "name": "  wire_money\n",
      "match": true,
      "why": "tool names are trimmed, as Cloud does"
    },
    {
      "pattern": "x",
      "name": " x ",
      "match": true
    }
  ],
